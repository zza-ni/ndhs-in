{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/firebase-messaging-sw.js", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/(.)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}